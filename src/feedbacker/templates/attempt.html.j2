{% extends "course_base.html.j2" %}
{% set active_page = "assignments" %}

{% macro truefalse(idx, problem, name) -%}
  <div class="mt-3">
    <p>{{ idx }}. {{ problem.text }}</p>
    <div class="ms-3">
      <fieldset>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="{{ name }}" id="trueFalseTrue{{ idx }}" value="true">
          <label class="form-check-label" for="trueFalseTrue{{ idx }}">
            True
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="{{ name }}" id="trueFalseFalse{{ idx }}" value="false">
          <label class="form-check-label" for="trueFalseFalse{{ idx }}">
            False
          </label>
        </div>
      </fieldset>
    </div>
  </div>
{%- endmacro %}

{% macro multiplechoice(idx, problem, name) -%}
  <div class="mt-3">
    <p>{{ idx }}. {{ problem.text }}</p>
    <div class="ms-3">
      <fieldset>
        {% for choice in problem.options %}
          <div class="form-check">
            <input class="form-check-input" type="radio" name="{{ name }}" id="multipleChoice{{ idx }}{{ loop.index }}" value="{{ loop.index }}">
            <label class="form-check-label" for="multipleChoice{{ idx }}{{ loop.index }}">
              {{ choice }} 
            </label>
          </div>
        {% endfor %}
      </fieldset>
    </div>
  </div>
{%- endmacro %}

{% macro file(idx, problem, name) -%}
  <div class="mt-3">
    <p>{{ idx }}. {{ problem.text }}</p>
    <div class="ms-3">
      <fieldset>
        <div>
          {# <label for="formFile" class="form-label mt-4">Default file input example</label> #}
          <input class="form-control" type="file" id="fileUpload" name="file">
        </div>
      </fieldset>
    </div>
  </div>
{%- endmacro %}

{% block title %}Attempt{% endblock %}
{% block content %}
    <h1>{{ assignment.title }}</h1>
    <p class="important">
      Welcome to my awesome Homework Attempt page.
    </p>

    <div class="bg-light p-3 border-top border-bottom rounded">
    {{ assignment_html | safe }}
    </div>

    <form data-bitwarden-watching="1" method="post" enctype="multipart/form-data">
      {% for problem in problems %}
        {% if problem.type == "true_false" %}
          {{ truefalse(loop.index, problem, "problem" ~ loop.index) }}
        {% elif problem.type == "multiple_choice" %}
          {{ multiplechoice(loop.index, problem, "problem" ~ loop.index) }}
        {% elif problem.type == "file" %}
          {{ file(loop.index, problem, "problem" ~ loop.index) }}
        {% endif %}
      {% endfor %}

      <fieldset>
        <div>
          <label for="exampleTextarea" class="form-label mt-4">Example textarea</label>
          <textarea class="form-control" id="exampleTextarea" rows="3"></textarea>
        </div>
        <div>
          <label for="formFile" class="form-label mt-4">Default file input example</label>
          <input class="form-control" type="file" id="fileUpload" name="file" required>
        </div>
        <button type="submit" class="btn btn-primary my-3">Submit</button>
      </fieldset>
    </form>

    <script type="text/javascript">
      
    </script>
{% endblock %}

